/*
 * Block rewards: high-level system design
 *
 * Render:
 *   dot -Tpng -Gdpi=160 high-level-system-design.dot -o high-level-system-design.png
 *   dot -Tsvg           high-level-system-design.dot -o high-level-system-design.svg
 */

digraph high_level_system_design {
  rankdir = LR;
  bgcolor = "#1f2020";
  splines = true;
  nodesep = 0.40;
  ranksep = 1.10;
  pad     = 0.25;

  node [
    shape     = box,
    style     = "rounded,filled",
    fillcolor = "#1f2020",
    color     = "#cfcfcf",
    penwidth  = 1.5,
    fontname  = "Helvetica",
    fontsize  = 18,
    fontcolor = "#d8d8d8",
    margin    = "0.20,0.22",
    width     = 3.40,
    height    = 0.85
  ];

  edge [
    color     = "#cfcfcf",
    penwidth  = 2,
    arrowsize = 0.9
  ];

  edge [fontname = "Helvetica", fontsize = 15, fontcolor = "#d8d8d8"];

  /* Inputs: the two KPIs of the block and the fixed parameters */
  stake    [label = "KPI 1: Inferred Total Stake\nof the epoch"];
  fees     [label = "KPI 2: Fees Pooled in the Block\n(net of the proof of work share)"];
  params   [label = "Parameters:\nI_max = 1%, alpha_d, alpha_a, targets"];

  /* Stocks allocated at genesis or fed by the fees */
  reserve  [label = "Rewards Reserve\n(allocated at genesis)"];
  pool     [label = "Rewards Pool"];

  /* Computation and output */
  factor   [label = "Emission Rate Factor A_t"];
  reward   [label = "Block Reward R_t"];
  paid     [label = "Leader and\nBlend Service"];

  { rank = same; stake; fees; params; }
  { rank = same; reserve; factor; pool; }

  /* The emission rate factor combines the KPIs within the parameters */
  stake  -> factor;
  fees   -> factor;
  params -> factor;

  /* The fees of the block go to the pool */
  fees -> pool [label = "  fees of the block  "];

  /* The reward releases from the reserve and pays back part of the fees */
  factor  -> reward;
  reserve -> reward [label = "  A_t x maximum release  "];
  pool    -> reward [label = "  (1 - A_t) x fees  "];

  reward -> paid;
}
